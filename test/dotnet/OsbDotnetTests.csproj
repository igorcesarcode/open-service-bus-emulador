<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- DeleteMessagesAsync and PurgeMessagesAsync are public only in this
         beta: the stable releases up to 7.21.0 make them internal. The
         transactions and UseDevelopmentEmulator work the same in it. -->
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.18.0-beta.1" />
  </ItemGroup>

</Project>
