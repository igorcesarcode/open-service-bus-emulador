package views

import "strconv"

templ PropertiesPageView(l Layout, p PropertiesPage) {
	@Page(l) {
		<h2 class="pagetitle">Properties and locks</h2>
		<p class="hint">
			Tags and encryption are kept for display and export; they do not change how the namespace behaves. Locks stop changes of entities and
			rules, like Azure resource locks: ReadOnly stops every change and CanNotDelete stops deletions, including the auto-delete on idle.
			Sending and receiving messages is never stopped. The SQLite file is not encrypted.
		</p>
		if p.Message != "" {
			<p class="notice" role="status">{ p.Message }</p>
		}
		if p.Error != "" {
			<p class="error" role="alert">{ p.Error }</p>
		}
		<h3 class="section">Locks</h3>
		<table class="list">
			<thead><tr><th>Name</th><th>Lock type</th><th>Scope</th><th>Notes</th><th></th></tr></thead>
			<tbody>
				for _, r := range p.Locks {
					<tr>
						<td class="name">{ r.Name }</td>
						<td>{ r.Level }</td>
						<td>{ r.Scope }</td>
						<td>{ r.Notes }</td>
						<td class="act">
							<form method="post" action="/$portal/properties/action" class="inline">
								<input type="hidden" name="action" value="delete-lock"/>
								<input type="hidden" name="name" value={ r.Name }/>
								<button type="submit" class="small danger">Delete</button>
							</form>
						</td>
					</tr>
				}
				if len(p.Locks) == 0 {
					<tr class="empty"><td colspan="5">No locks.</td></tr>
				}
			</tbody>
		</table>
		<form class="form" method="post" action="/$portal/properties/action">
			<input type="hidden" name="action" value="add-lock"/>
			<label class="field"><span>Lock name</span><input name="name" required/></label>
			<label class="field">
				<span>Lock type</span>
				<select name="level">
					<option value="CanNotDelete">Delete (CanNotDelete)</option>
					<option value="ReadOnly">Read-only (ReadOnly)</option>
				</select>
			</label>
			<label class="field">
				<span>Scope</span>
				<select name="scope">
					for _, o := range p.Scopes {
						<option value={ o.Value }>{ o.Label }</option>
					}
				</select>
			</label>
			<label class="field"><span>Notes</span><input name="notes"/></label>
			<div class="actions"><button type="submit" class="primary">Add lock</button></div>
		</form>
		<h3 class="section">Tags</h3>
		<form class="form" method="post" action="/$portal/properties/action">
			<input type="hidden" name="action" value="set-tags"/>
			<label class="field">
				<span>One name=value per line</span>
				<textarea name="tags" rows={ strconv.Itoa(max(3, len(p.Tags)/20)) }>{ p.Tags }</textarea>
			</label>
			<div class="actions"><button type="submit" class="primary">Save tags</button></div>
		</form>
		<h3 class="section">Encryption</h3>
		<form class="form" method="post" action="/$portal/properties/action">
			<input type="hidden" name="action" value="set-encryption"/>
			<label class="field">
				<span>Customer-managed key (Key Vault key ids, one per line)</span>
				<textarea name="keys" rows="2">{ p.KeyIDs }</textarea>
			</label>
			<label class="field"><span>Identity</span><input name="identity" value={ p.Identity }/></label>
			<fieldset>
				<label class="check"><input type="checkbox" name="infrastructure" value="true" checked?={ p.Infrastructure }/> Infrastructure encryption (double encryption)</label>
			</fieldset>
			<div class="actions">
				<button type="submit" class="primary">Save encryption</button>
				if p.Encrypted {
					<button type="submit" name="action" value="clear-encryption" class="small">Remove</button>
				}
			</div>
		</form>
	}
}

templ ExportPageView(l Layout, p ExportPage) {
	@Page(l) {
		<h2 class="pagetitle">Export template</h2>
		<p class="hint">
			The current entities, rules, access policies, role assignments, locks, tags and Geo-DR pairings of every namespace, as a Config.json
			and as Terraform with azurerm_* resources. Start the emulator with <code>-config</code> or <code>-terraform</code> to get them back.
			Messages are not exported.
		</p>
		if p.Error != "" {
			<p class="error" role="alert">{ p.Error }</p>
		}
		for _, f := range p.Files {
			<h3 class="section">{ f.Name } <small>({ strconv.Itoa(f.Size) } bytes)</small></h3>
			<p><a class="button" href={ templ.SafeURL("/$portal/export/" + f.Name) } download={ f.Name }>Download</a></p>
			<pre class="code">{ f.Preview }</pre>
		}
	}
}
