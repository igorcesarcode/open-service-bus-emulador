package views

import "fmt"

templ RulesPageView(l Layout, p RulesPage) {
	@Page(l) {
		<div class="crumbs">
			<a href={ templ.SafeURL(EntityLink(p.Path)) }>{ p.Name }</a> &rsaquo; <strong>Rules</strong>
		</div>
		<div class="commands">
			<a class="cmd" href={ templ.SafeURL("/$portal/rules/new?path=" + queryEscape(p.Path)) }>+ Rule</a>
		</div>
		<table class="list">
			<thead><tr><th>Name</th><th>Type</th><th>Filter</th><th>Action</th><th></th></tr></thead>
			<tbody>
				for _, r := range p.Rules {
					<tr>
						<td class="name">{ r.Name }</td>
						<td>{ r.Type }</td>
						<td><code>{ r.Filter }</code></td>
						<td><code>{ r.Action }</code></td>
						<td class="act">
							<a class="cmd" href={ templ.SafeURL("/$portal/rules/edit?path=" + queryEscape(p.Path) + "&name=" + queryEscape(r.Name)) }>Edit</a>
							<button type="button" class="small danger" hx-post="/$portal/rules/delete" hx-vals={ fmt.Sprintf(`{"path": %q, "name": %q}`, p.Path, r.Name) } hx-confirm={ "Delete rule " + r.Name + "?" } hx-target="closest tr" hx-swap="outerHTML">Delete</button>
						</td>
					</tr>
				}
				if len(p.Rules) == 0 {
					<tr class="empty"><td colspan="5">No rules: the subscription receives no message.</td></tr>
				}
			</tbody>
		</table>
		<h3 class="section">Test the filters</h3>
		<p class="hint">Describe a message, one property per line as <code>name = value</code>. Prefix system properties with <code>sys.</code>, such as <code>sys.Label = order.created</code>. Numbers and true or false are typed; anything else is text.</p>
		<form class="tester" hx-post="/$portal/rules/test" hx-target="#results">
			<input type="hidden" name="path" value={ p.Path }/>
			<textarea name="sample" rows="6" spellcheck="false">{ p.Sample }</textarea>
			<button type="submit" class="primary">Test</button>
		</form>
		<div id="results">
			@RuleResults(p)
		</div>
	}
}

templ RuleResults(p RulesPage) {
	if p.Tested {
		<table class="list">
			<thead><tr><th>Rule</th><th>Result</th><th>Changes made by the action</th></tr></thead>
			<tbody>
				for _, r := range p.Results {
					<tr>
						<td class="name">{ r.Name }</td>
						<td>
							if r.Error != "" {
								<span class="status off">Error: { r.Error }</span>
							} else if r.Matched {
								<span class="status">Delivered</span>
							} else {
								<span class="status off">Not delivered</span>
							}
						</td>
						<td>
							for _, c := range r.Changes {
								<div><code>{ c }</code></div>
							}
						</td>
					</tr>
				}
				if len(p.Results) == 0 {
					<tr class="empty"><td colspan="3">The subscription has no rules.</td></tr>
				}
			</tbody>
		</table>
	}
}

templ RuleFormPage(l Layout, f RuleForm) {
	@Page(l) {
		<h2 class="pagetitle">
			if f.Edit {
				Edit rule { f.Name }
			} else {
				New rule on { f.SubName }
			}
		</h2>
		if f.Error != "" {
			<p class="error" role="alert">{ f.Error }</p>
		}
		<form class="form wide" method="post" action="/$portal/rules/save" hx-post="/$portal/rules/validate" hx-trigger="input changed delay:400ms from:find textarea, change from:find select" hx-target="#validation" hx-swap="innerHTML" hx-disinherit="*">
			<input type="hidden" name="path" value={ f.Path }/>
			if f.Edit {
				<input type="hidden" name="edit" value="1"/>
			}
			<label class="field">
				<span>Name</span>
				if f.Edit {
					<input name="name" value={ f.Name } readonly/>
				} else {
					<input name="name" value={ f.Name } required autofocus/>
				}
			</label>
			<label class="field">
				<span>Filter type</span>
				<select name="kind">
					for _, k := range f.Kinds {
						<option value={ k } selected?={ k == f.Kind }>{ k }</option>
					}
				</select>
			</label>
			<label class="field">
				<span>SQL filter</span>
				<textarea name="sql" rows="3" spellcheck="false">{ f.SQL }</textarea>
				<small>Used by the Sql type, such as <code>quantity &gt; 10 AND sys.Label LIKE 'order.%'</code>.</small>
			</label>
			<label class="field">
				<span>SQL filter parameters</span>
				<textarea name="parameters" rows="2" spellcheck="false">{ f.Parameters }</textarea>
				<small>One <code>name = value</code> per line, for { "@name" } references.</small>
			</label>
			<fieldset>
				<legend>Correlation filter</legend>
				for _, c := range f.Correlation {
					<label class="field">
						<span>{ c.Label }</span>
						<input name={ c.Name } value={ c.Value }/>
					</label>
				}
				<label class="field">
					<span>Custom properties</span>
					<textarea name="corrprops" rows="2" spellcheck="false">{ f.CorrProps }</textarea>
					<small>One <code>name = value</code> per line.</small>
				</label>
			</fieldset>
			<label class="field">
				<span>SQL action</span>
				<textarea name="action" rows="2" spellcheck="false">{ f.Action }</textarea>
				<small>Such as <code>SET region = 'eu'; REMOVE debug</code>.</small>
			</label>
			<div id="validation" class="validation" aria-live="polite"></div>
			<div class="actions">
				<button type="submit" class="primary">Save</button>
				<a class="cmd" href={ templ.SafeURL("/$portal/rules?path=" + queryEscape(f.Path)) }>Cancel</a>
			</div>
		</form>
	}
}

templ Validation(ok bool, msg string) {
	if ok {
		<span class="status">The rule is valid.</span>
	} else {
		<span class="error">{ msg }</span>
	}
}
